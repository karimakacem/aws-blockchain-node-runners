##############################################################
# Arbitrum One Mainnet Configuration
##############################################################

# AWS Account Configuration
AWS_ACCOUNT_ID="xxxxxxxxxxx"
AWS_REGION="us-east-1"

# Arbitrum Network Configuration
ARBITRUM_NETWORK="arb1"                         # Arbitrum One mainnet
ARBITRUM_NODE_TYPE="full"                       # Options: "full" | "archive"
ARBITRUM_SNAPSHOT_TYPE="pruned"                 # Options: "pruned" | "archive" | "genesis" | "none"
NITRO_VERSION="v3.2.1-d81324d"                  # Check latest: https://github.com/OffchainLabs/nitro/releases

# REQUIRED: Ethereum L1 Endpoints
# Default: Free public endpoints from publicnode.com (rate-limited, suitable for testing)
# Production: Use paid providers (Alchemy, Infura, QuickNode) or run your own Ethereum node
L1_RPC_URL="https://ethereum-rpc.publicnode.com"
L1_BEACON_URL="https://ethereum-beacon-api.publicnode.com"
# Alternative paid options:
#L1_RPC_URL="https://eth-mainnet.g.alchemy.com/v2/YOUR-API-KEY"
#L1_BEACON_URL="https://eth-beacon-mainnet.infura.io/YOUR-API-KEY"

# Network Ports
ARBITRUM_RPC_PORT="8547"
ARBITRUM_WS_PORT="8548"
ARBITRUM_METRICS_PORT="6070"

# Single Node Configuration
ARBITRUM_SINGLE_NODE_INSTANCE_TYPE="m6i.2xlarge"     # 8 vCPUs, 32GB RAM
ARBITRUM_SINGLE_NODE_CPU_TYPE="X86_64"
ARBITRUM_SINGLE_NODE_DATA_VOL_SIZE="2000"            # 2TB for pruned mainnet node
ARBITRUM_SINGLE_NODE_DATA_VOL_TYPE="gp3"
ARBITRUM_SINGLE_NODE_DATA_VOL_IOPS="7000"
ARBITRUM_SINGLE_NODE_DATA_VOL_THROUGHPUT="500"

# HA RPC Nodes Configuration
ARBITRUM_RPC_INSTANCE_TYPE="m6i.2xlarge"
ARBITRUM_RPC_CPU_TYPE="X86_64"
ARBITRUM_RPC_NUMBER_OF_NODES="2"                     # 2-4 nodes recommended
ARBITRUM_RPC_ALB_HEALTHCHECK_GRACE_PERIOD_MIN="30"   # Time to download snapshot and sync
ARBITRUM_RPC_HA_NODES_HEARTBEAT_DELAY_MIN="180"      # ASG lifecycle hook timeout (3 hours)
ARBITRUM_RPC_DATA_VOL_SIZE="2000"
ARBITRUM_RPC_DATA_VOL_TYPE="gp3"
ARBITRUM_RPC_DATA_VOL_IOPS="7000"
ARBITRUM_RPC_DATA_VOL_THROUGHPUT="500"

# Deployment Instructions
# 1. Update L1_RPC_URL and L1_BEACON_URL with your Ethereum endpoints
# 2. Deploy common stack:
#    npx cdk deploy arbitrum-one-common
# 3. For single node:
#    npx cdk deploy arbitrum-one-single-node
# 4. For HA setup:
#    npx cdk deploy arbitrum-one-ha-rpc
