# AWS Configuration
AWS_ACCOUNT_ID="xxxxxxxxxxx"
AWS_REGION="us-east-1"

# Arbitrum Network Configuration
ARBITRUM_NETWORK="arb1"
ARBITRUM_NODE_TYPE="full"
ARBITRUM_SNAPSHOT_TYPE="pruned"  # Options: pruned, archive, none

# Nitro Version
# Check latest releases: https://github.com/OffchainLabs/nitro/releases
NITRO_VERSION="v3.2.1-d81324d"

# Ethereum L1 Endpoints (REQUIRED)
# Default: Free public endpoints from publicnode.com (rate-limited, suitable for testing)
# Production: Use paid providers (Alchemy, Infura, QuickNode) or run your own Ethereum node
L1_RPC_URL="https://ethereum-rpc.publicnode.com"
L1_BEACON_URL="https://ethereum-beacon-api.publicnode.com"
# Alternative paid options:
#L1_RPC_URL="https://eth-mainnet.g.alchemy.com/v2/YOUR-API-KEY"
#L1_BEACON_URL="https://eth-beacon-mainnet.infura.io/YOUR-API-KEY"

# HA RPC Nodes Configuration
ARBITRUM_RPC_INSTANCE_TYPE="m6i.2xlarge"  # Options: m6i.xlarge, m6i.2xlarge, m6i.4xlarge, m7g.2xlarge
ARBITRUM_RPC_CPU_TYPE="X86_64"            # Options: X86_64, ARM_64 (for Graviton instances)
ARBITRUM_RPC_NUMBER_OF_NODES="2"          # Number of RPC nodes (2-4)

# Storage Configuration for RPC Nodes
ARBITRUM_RPC_DATA_VOL_SIZE="2000"         # Size in GiB (2000 for pruned, 4000+ for archive)
ARBITRUM_RPC_DATA_VOL_TYPE="gp3"          # Options: gp3, io1, io2
ARBITRUM_RPC_DATA_VOL_IOPS="7000"         # For gp3: 3000-16000, io1/io2: up to 64000
ARBITRUM_RPC_DATA_VOL_THROUGHPUT="500"    # For gp3 only: 125-1000 MiB/s

# High Availability Configuration
ARBITRUM_RPC_ALB_HEALTHCHECK_GRACE_PERIOD_MIN="30"  # Health check grace period in minutes
ARBITRUM_RPC_HA_NODES_HEARTBEAT_DELAY_MIN="180"     # Lifecycle hook timeout in minutes (for snapshot download + sync)

# Network Ports (usually no need to change)
ARBITRUM_RPC_PORT="8547"
ARBITRUM_WS_PORT="8548"
ARBITRUM_METRICS_PORT="6070"
