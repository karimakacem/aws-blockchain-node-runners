##############################################################
# Example configuration for Avalanche nodes runner app on AWS #
# Mainnet - ARM64 (Graviton) Configuration                    #
##############################################################

# Set the AWS account id and region for your environment
AWS_ACCOUNT_ID="xxxxxxxxxxx"
AWS_REGION="us-east-1"

# Common configuration parameters
AVALANCHE_NETWORK="mainnet"                     # All options: "mainnet" | "fuji"
AVALANCHE_NODE_TYPE="full"                      # All options: "full" | "validator" | "api"

# AvalancheGo version
AVALANCHEGO_VERSION="v1.11.11"                  # Check latest: https://github.com/ava-labs/avalanchego/releases

# Configuration for node data snapshot management
AVALANCHE_SNAPSHOT_TYPE="none"                  # All options: "s3" | "none"

# Sync node configuration (in case you used AVALANCHE_SNAPSHOT_TYPE="s3")
AVALANCHE_SYNC_INSTANCE_TYPE="c7g.2xlarge"
AVALANCHE_SYNC_CPU_TYPE="ARM_64"                # IMPORTANT: Make sure the CPU type matches the instance type used
AVALANCHE_SYNC_DATA_VOL_SIZE="1000"             # Minimum: 1000 GiB for mainnet, 500 GiB for fuji
AVALANCHE_SYNC_DATA_VOL_TYPE="gp3"              # Other options: "io1" | "io2" | "gp3"
AVALANCHE_SYNC_DATA_VOL_IOPS="3000"             # Max IOPS for EBS volumes
AVALANCHE_SYNC_DATA_VOL_THROUGHPUT="250"        # Max throughput for EBS gp3 volumes

# Single RPC node configuration
AVALANCHE_SINGLE_NODE_INSTANCE_TYPE="c7g.2xlarge"
AVALANCHE_SINGLE_NODE_CPU_TYPE="ARM_64"         # IMPORTANT: Make sure the CPU type matches the instance type used
AVALANCHE_SINGLE_NODE_DATA_VOL_SIZE="1000"      # Minimum: 1000 GiB for mainnet, 500 GiB for fuji
AVALANCHE_SINGLE_NODE_DATA_VOL_TYPE="gp3"       # Other options: "io1" | "io2" | "gp3"
AVALANCHE_SINGLE_NODE_DATA_VOL_IOPS="3000"      # Max IOPS for EBS volumes
AVALANCHE_SINGLE_NODE_DATA_VOL_THROUGHPUT="250" # Max throughput for EBS gp3 volumes

# RPC nodes configuration (HA setup with ALB)
AVALANCHE_RPC_INSTANCE_TYPE="c7g.2xlarge"
AVALANCHE_RPC_CPU_TYPE="ARM_64"                 # IMPORTANT: Make sure the CPU type matches the instance type used
AVALANCHE_RPC_DATA_VOL_SIZE="1000"              # Minimum: 1000 GiB for mainnet, 500 GiB for fuji
AVALANCHE_RPC_DATA_VOL_TYPE="gp3"               # Other options: "io1" | "io2" | "gp3"
AVALANCHE_RPC_DATA_VOL_IOPS="3000"              # Max IOPS for EBS volumes
AVALANCHE_RPC_DATA_VOL_THROUGHPUT="250"         # Max throughput for EBS gp3 volumes

# Additional configuration for HA RPC Nodes
AVALANCHE_RPC_NUMBER_OF_NODES="2"                       # Total number of RPC nodes to be provisioned. Default: 2
AVALANCHE_RPC_ALB_HEALTHCHECK_GRACE_PERIOD_MIN="10"     # Time enough to initialize the instance and start downloading snapshots
AVALANCHE_RPC_HA_NODES_HEARTBEAT_DELAY_MIN="120"        # Time sufficient for a node to download snapshot, start AvalancheGo, and finish syncing

# Networking ports (default Avalanche ports)
AVALANCHE_HTTP_PORT="9650"
AVALANCHE_STAKING_PORT="9651"
