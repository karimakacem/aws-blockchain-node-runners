# Avalanche HA RPC Nodes Configuration
# Multiple RPC nodes behind ALB for high availability

## AWS Account Configuration
AWS_ACCOUNT_ID="xxxxxxxxxxx"
AWS_REGION="us-east-1"

## Avalanche Network Configuration
AVALANCHE_NETWORK="mainnet"
AVALANCHEGO_VERSION="v1.14.2"
AVALANCHE_NODE_TYPE="full"
AVALANCHE_SNAPSHOT_TYPE="s3"  # Required - RPC nodes restore from S3

## Network Ports
AVALANCHE_HTTP_PORT="9650"
AVALANCHE_STAKING_PORT="9651"

## Sync Node Configuration (required for S3 snapshots)
AVALANCHE_SYNC_INSTANCE_TYPE="c6i.4xlarge"
AVALANCHE_SYNC_CPU_TYPE="x86_64"
AVALANCHE_SYNC_DATA_VOL_SIZE="2000"
AVALANCHE_SYNC_DATA_VOL_TYPE="gp3"
AVALANCHE_SYNC_DATA_VOL_IOPS="5000"
AVALANCHE_SYNC_DATA_VOL_THROUGHPUT="500"

## Single Node Configuration (not used for HA deployment)
AVALANCHE_SINGLE_NODE_INSTANCE_TYPE="c6i.2xlarge"
AVALANCHE_SINGLE_NODE_CPU_TYPE="x86_64"
AVALANCHE_SINGLE_NODE_DATA_VOL_SIZE="1000"
AVALANCHE_SINGLE_NODE_DATA_VOL_TYPE="gp3"
AVALANCHE_SINGLE_NODE_DATA_VOL_IOPS="3000"
AVALANCHE_SINGLE_NODE_DATA_VOL_THROUGHPUT="250"

## HA RPC Nodes Configuration
AVALANCHE_RPC_INSTANCE_TYPE="c6i.2xlarge"  # 8 vCPUs, 16GB RAM
AVALANCHE_RPC_CPU_TYPE="x86_64"
AVALANCHE_RPC_NUMBER_OF_NODES="2"  # 2-4 nodes recommended
AVALANCHE_RPC_ALB_HEALTHCHECK_GRACE_PERIOD_MIN="15"  # Time for nodes to download snapshot
AVALANCHE_RPC_HA_NODES_HEARTBEAT_DELAY_MIN="180"  # ASG lifecycle hook timeout (3 hours)
AVALANCHE_RPC_DATA_VOL_SIZE="1500"  # Slightly larger than snapshot for growth
AVALANCHE_RPC_DATA_VOL_TYPE="gp3"
AVALANCHE_RPC_DATA_VOL_IOPS="3000"
AVALANCHE_RPC_DATA_VOL_THROUGHPUT="250"

## Deployment Instructions
# 1. Deploy common stack with S3 bucket:
#    cdk deploy avalanche-common
#
# 2. Deploy sync node (creates initial snapshot):
#    cdk deploy avalanche-sync-node
#    Wait 24-48 hours for full sync and first snapshot
#
# 3. Deploy HA RPC nodes (restore from snapshot):
#    cdk deploy avalanche-rpc-nodes
#
# Access RPC via ALB: http://<alb-dns-name>:9650/ext/info
