# Avalanche Sync Node Configuration
# This node syncs the blockchain and uploads snapshots to S3 for RPC nodes to use

## AWS Account Configuration
AWS_ACCOUNT_ID="xxxxxxxxxxx"
AWS_REGION="us-east-1"

## Avalanche Network Configuration
AVALANCHE_NETWORK="mainnet"
AVALANCHEGO_VERSION="v1.14.2"
AVALANCHE_NODE_TYPE="full"
AVALANCHE_SNAPSHOT_TYPE="s3"  # Enable S3 snapshots for HA deployment

## Network Ports
AVALANCHE_HTTP_PORT="9650"
AVALANCHE_STAKING_PORT="9651"

## Sync Node Instance Configuration
# Larger instance recommended for sync node as it handles full sync + snapshot uploads
AVALANCHE_SYNC_INSTANCE_TYPE="c6i.4xlarge"  # 16 vCPUs, 32GB RAM
AVALANCHE_SYNC_CPU_TYPE="x86_64"

## Sync Node Data Volume Configuration
# Large volume needed for full blockchain data
AVALANCHE_SYNC_DATA_VOL_SIZE="2000"  # 2TB recommended for mainnet with growth
AVALANCHE_SYNC_DATA_VOL_TYPE="gp3"
AVALANCHE_SYNC_DATA_VOL_IOPS="5000"
AVALANCHE_SYNC_DATA_VOL_THROUGHPUT="500"

## Single Node Configuration (not used for sync-node deployment)
AVALANCHE_SINGLE_NODE_INSTANCE_TYPE="c6i.2xlarge"
AVALANCHE_SINGLE_NODE_CPU_TYPE="x86_64"
AVALANCHE_SINGLE_NODE_DATA_VOL_SIZE="1000"
AVALANCHE_SINGLE_NODE_DATA_VOL_TYPE="gp3"
AVALANCHE_SINGLE_NODE_DATA_VOL_IOPS="3000"
AVALANCHE_SINGLE_NODE_DATA_VOL_THROUGHPUT="250"

## HA RPC Nodes Configuration (not used for sync-node deployment)
AVALANCHE_RPC_INSTANCE_TYPE="c6i.2xlarge"
AVALANCHE_RPC_CPU_TYPE="x86_64"
AVALANCHE_RPC_NUMBER_OF_NODES="2"
AVALANCHE_RPC_ALB_HEALTHCHECK_GRACE_PERIOD_MIN="10"
AVALANCHE_RPC_HA_NODES_HEARTBEAT_DELAY_MIN="120"
AVALANCHE_RPC_DATA_VOL_SIZE="1500"
AVALANCHE_RPC_DATA_VOL_TYPE="gp3"
AVALANCHE_RPC_DATA_VOL_IOPS="3000"
AVALANCHE_RPC_DATA_VOL_THROUGHPUT="250"

## Deployment Note
# Deploy order for HA setup:
# 1. cdk deploy avalanche-common
# 2. cdk deploy avalanche-sync-node (wait for full sync ~24-48 hours)
# 3. cdk deploy avalanche-rpc-nodes (will restore from S3 snapshot)
