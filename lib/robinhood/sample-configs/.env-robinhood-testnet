##############################################################
# Robinhood Chain Testnet Configuration
# NOTE: Testnet only - Mainnet not yet launched
##############################################################

# AWS Account Configuration
AWS_ACCOUNT_ID="xxxxxxxxxxx"
AWS_REGION="us-east-1"

# Robinhood Chain Network Configuration
ROBINHOOD_NETWORK="robinhood-testnet"           # Robinhood Chain Sepolia testnet
ROBINHOOD_NODE_TYPE="full"                      # Options: "full" | "archive"
NITRO_VERSION="v3.2.1-d81324d"                  # Arbitrum Nitro version

# REQUIRED: Ethereum Sepolia L1 Endpoints
# Robinhood Chain testnet runs on Ethereum Sepolia (not mainnet)
# Default: Free public endpoints from publicnode.com (rate-limited, suitable for testing)
# Production: Use paid providers (Alchemy, Infura, QuickNode) or run your own Ethereum node
L1_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"
L1_BEACON_URL="https://ethereum-sepolia-beacon-api.publicnode.com"
# Alternative paid options:
#L1_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/YOUR-API-KEY"
#L1_BEACON_URL="https://ethereum-sepolia-beacon-api.infura.io/YOUR-API-KEY"

# Network Ports
ROBINHOOD_RPC_PORT="8547"
ROBINHOOD_WS_PORT="8548"
ROBINHOOD_METRICS_PORT="6070"

# Single Node Configuration
ROBINHOOD_SINGLE_NODE_INSTANCE_TYPE="m6i.2xlarge"     # 8 vCPUs, 32GB RAM
ROBINHOOD_SINGLE_NODE_CPU_TYPE="X86_64"
ROBINHOOD_SINGLE_NODE_DATA_VOL_SIZE="1000"            # 1TB for testnet node
ROBINHOOD_SINGLE_NODE_DATA_VOL_TYPE="gp3"
ROBINHOOD_SINGLE_NODE_DATA_VOL_IOPS="5000"
ROBINHOOD_SINGLE_NODE_DATA_VOL_THROUGHPUT="500"

# HA RPC Nodes Configuration
ROBINHOOD_RPC_INSTANCE_TYPE="m6i.2xlarge"
ROBINHOOD_RPC_CPU_TYPE="X86_64"
ROBINHOOD_RPC_NUMBER_OF_NODES="2"                     # 2-4 nodes recommended
ROBINHOOD_RPC_ALB_HEALTHCHECK_GRACE_PERIOD_MIN="30"   # Time for initial sync
ROBINHOOD_RPC_HA_NODES_HEARTBEAT_DELAY_MIN="120"      # ASG lifecycle hook timeout (2 hours)
ROBINHOOD_RPC_DATA_VOL_SIZE="1000"
ROBINHOOD_RPC_DATA_VOL_TYPE="gp3"
ROBINHOOD_RPC_DATA_VOL_IOPS="5000"
ROBINHOOD_RPC_DATA_VOL_THROUGHPUT="500"

# Robinhood Chain Details (Testnet)
# Chain ID: 46630
# Sequencer: https://sequencer.testnet.chain.robinhood.com
# Feed: wss://feed.testnet.chain.robinhood.com
# Bridge: 0x96295BDad104eaD97cC08797b3dC68efF59CcF30 (on Sepolia)
# Config: https://cdn.robinhood.com/chain/testnet/robinhood-chain-testnet-config.json

# Deployment Instructions
# 1. Update AWS_ACCOUNT_ID with your AWS account
# 2. Verify L1_RPC_URL and L1_BEACON_URL (Sepolia endpoints required)
# 3. Deploy common stack:
#    npx cdk deploy robinhood-common
# 4. For single node:
#    npx cdk deploy robinhood-single-node
# 5. For HA setup:
#    npx cdk deploy robinhood-rpc-nodes

# IMPORTANT: This is TESTNET ONLY
# Mainnet configuration will be added when Robinhood Chain launches on mainnet
