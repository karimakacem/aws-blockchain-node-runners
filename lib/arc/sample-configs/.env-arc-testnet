##############################################################
# Circle ARC Testnet Configuration
##############################################################

# AWS Account Configuration
AWS_ACCOUNT_ID="xxxxxxxxxxx"
AWS_REGION="us-east-1"

# ARC Network Configuration
ARC_NETWORK="testnet"                           # Currently only testnet available
ARC_VERSION="0.6.0"                             # Check latest: https://github.com/circlefin/arc-node/releases
ARC_SNAPSHOT_DOWNLOAD="true"                    # Download snapshot for faster sync (recommended)

# Network Ports
ARC_EXECUTION_RPC_PORT="8545"                   # Execution layer JSON-RPC (standard Ethereum API)
ARC_EXECUTION_WS_PORT="8546"                    # Execution layer WebSocket
ARC_EXECUTION_METRICS_PORT="9001"               # Execution layer Prometheus metrics
ARC_CONSENSUS_RPC_PORT="31000"                  # Consensus layer RPC
ARC_CONSENSUS_METRICS_PORT="29000"              # Consensus layer Prometheus metrics

# Single Node Configuration
ARC_SYNC_INSTANCE_TYPE="r6i.4xlarge"            # 16 vCPUs, 128GB RAM (minimum 64GB required)
ARC_SYNC_CPU_TYPE="X86_64"                      # X86_64 or ARM_64
ARC_SYNC_DATA_VOL_SIZE="1000"                   # 1TB storage (minimum for testnet)
ARC_SYNC_DATA_VOL_TYPE="gp3"
ARC_SYNC_DATA_VOL_IOPS="7000"
ARC_SYNC_DATA_VOL_THROUGHPUT="500"

# HA RPC Nodes Configuration (future)
ARC_RPC_INSTANCE_TYPE="r6i.4xlarge"
ARC_RPC_CPU_TYPE="X86_64"
ARC_RPC_NUMBER_OF_NODES="2"
ARC_RPC_ALB_HEALTHCHECK_GRACE_PERIOD_MIN="30"   # Time to download snapshot and sync
ARC_RPC_HA_NODES_HEARTBEAT_DELAY_MIN="120"      # ASG lifecycle hook timeout (2 hours)
ARC_RPC_DATA_VOL_SIZE="1000"
ARC_RPC_DATA_VOL_TYPE="gp3"
ARC_RPC_DATA_VOL_IOPS="7000"
ARC_RPC_DATA_VOL_THROUGHPUT="500"

# Network Details (for reference)
# Chain ID: 5042002 (0x4CEF52)
# Native Currency: USDC (18 decimals internally, 6 decimals for ERC-20)
# Block Explorer: https://testnet.arcscan.app
# Faucet: https://faucet.circle.com
# Public RPC: https://rpc.testnet.arc.network

# Deployment Instructions
# 1. Update AWS_ACCOUNT_ID and AWS_REGION above
# 2. Deploy common stack:
#    npx cdk deploy arc-common
# 3. For single node:
#    npx cdk deploy arc-single-node
# 4. For HA RPC nodes:
#    npx cdk deploy arc-rpc-nodes-testnet

# Notes:
# - Testnet only (mainnet not yet available)
# - Snapshot download is ~84 GB compressed, ~120+ GB extracted
# - Full node only (validators are permissioned)
# - Two-layer architecture: execution (Reth) + consensus (Malachite BFT)
# - Both containers must be healthy for node to function
