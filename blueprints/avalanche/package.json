{
  "name": "aws-bnr-blueprint-avalanche",
  "version": "2.0.0",
  "description": "Avalanche Primary Network node runner (mainnet + Fuji) — a non-validator AvalancheGo full node serving the C/P/X-Chain APIs, run from the official avaplatform/avalanchego Docker image",
  "engines": {
    "aws-blockchain-node-runners": ">=2.0.0"
  },
  "aws-blockchain-node-runner": {
    "BLOCKCHAIN_PROTOCOL": "avalanche",
    "supportedDeploymentModes": [
      "single-node",
      "ha-nodes"
    ],
    "defaultConfiguration": "avalanchego-v1.15.1-full.yml",
    "availableConfigurations": [
      {
        "name": "avalanchego-v1.15.1-full.yml",
        "version": "v1.15.1"
      }
    ],
    "BC_NETWORKS": [
      "mainnet",
      "fuji"
    ],
    "defaultInstanceTypes": {
      "x86_64": "i7i.2xlarge",
      "ARM_64": "i8g.2xlarge"
    },
    "requiredPorts": [
      {
        "port": 9650,
        "protocol": "tcp",
        "description": "AvalancheGo HTTP API (C/P/X-Chain RPC, info, health, metrics)",
        "public": false
      },
      {
        "port": 9651,
        "protocol": "tcp",
        "description": "AvalancheGo staking / P2P",
        "public": true
      }
    ],
    "monitoring": {
      "healthCheckPath": "/ext/health",
      "metricsPort": 9650,
      "clientNames": ["AvalancheGo"]
    },
    "storage": {
      "defaultDataVolumes": [
        {
          "name": "data",
          "sizeGiB": 1875,
          "type": "instance-store",
          "mountPath": "/data",
          "fileSystem": "ext4"
        }
      ]
    },
    "snapshot": {
      "enabled": false
    },
    "customEnvVarsNamePrefix": "AVALANCHE"
  }
}
