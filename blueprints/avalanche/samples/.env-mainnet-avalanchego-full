##############################################################
# Avalanche Mainnet - AvalancheGo (Full Node, non-validator)
# x86_64, single node
##############################################################

# AWS Configuration
AWS_ACCOUNT_ID="xxxxxxxxxxx"
AWS_REGION="us-east-1"

# Availability Zone (optional - override automatic AZ selection for single-node deployments)
# AWS_AZ="us-east-1a"

# Protocol Configuration
BLOCKCHAIN_PROTOCOL="avalanche"
DEPLOYMENT_MODE="single-node"
BC_NETWORK="mainnet"
CLIENT_CONFIG="avalanchego-v1.15.1-full.yml"

# Instance Configuration
# i7i.2xlarge: 8 vCPU, 64 GB RAM, 1 x 1875 GB local NVMe.
# ACP-256 minimum for Primary Network nodes: 8 vCPU, 16 GB RAM, 1 TB local NVMe;
# RPC (non-validator) nodes should use local NVMe rather than EBS.
INSTANCE_TYPE="i7i.2xlarge"
CPU_TYPE="x86_64"

# Storage Configuration - NVMe instance store
# A fresh state-synced mainnet node needs ~500 GB and then grows ~150-200 GB/month
# (state-sync snapshots kept every 4096 blocks). 1875 GB gives roughly 7 months
# before a resync (replace the instance). Instance store is wiped on stop/start:
# the node re-syncs and gets a new NodeID (fine for a non-validator).
DATA_VOLUMES_COUNT="1"
DATA_VOL_1_TYPE="instance-store"
DATA_VOL_1_SIZE="1875"
DATA_VOL_1_MOUNT_PATH="/data"
DATA_VOL_1_FILESYSTEM="ext4"

# Snapshot Configuration
# No database snapshot: the C-Chain state-syncs from peers and the P/X-Chains
# bootstrap from peers (2-4 hours on mainnet per the Avalanche docs).
SNAPSHOT_ENABLED="false"
