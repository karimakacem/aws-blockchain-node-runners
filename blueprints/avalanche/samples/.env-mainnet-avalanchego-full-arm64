##############################################################
# Avalanche Mainnet - AvalancheGo (Full Node, non-validator)
# ARM_64 (Graviton4), single node
##############################################################

# AWS Configuration
AWS_ACCOUNT_ID="xxxxxxxxxxx"
AWS_REGION="us-east-1"

# Availability Zone (optional - override automatic AZ selection for single-node deployments)
# AWS_AZ="us-east-1a"

# Protocol Configuration
BLOCKCHAIN_PROTOCOL="avalanche"
DEPLOYMENT_MODE="single-node"
BC_NETWORK="mainnet"
CLIENT_CONFIG="avalanchego-v1.15.1-full.yml"

# Instance Configuration
# i8g.2xlarge: 8 vCPU (Graviton4), 64 GB RAM, 1 x 1875 GB local NVMe.
# avaplatform/avalanchego:v1.15.1 is a multi-arch image (linux/amd64 + linux/arm64).
INSTANCE_TYPE="i8g.2xlarge"
CPU_TYPE="ARM_64"

# Storage Configuration - NVMe instance store
# ~500 GB after state sync, growing ~150-200 GB/month; 1875 GB lasts roughly
# 7 months before a resync. Wiped on stop/start (node re-syncs, new NodeID).
DATA_VOLUMES_COUNT="1"
DATA_VOL_1_TYPE="instance-store"
DATA_VOL_1_SIZE="1875"
DATA_VOL_1_MOUNT_PATH="/data"
DATA_VOL_1_FILESYSTEM="ext4"

# Snapshot Configuration
# No database snapshot: C-Chain state sync + P/X-Chain bootstrap from peers.
SNAPSHOT_ENABLED="false"
