##############################################################
# Avalanche Fuji Testnet - AvalancheGo (Full Node, non-validator)
# x86_64, single node
##############################################################

# AWS Configuration
AWS_ACCOUNT_ID="xxxxxxxxxxx"
AWS_REGION="us-east-1"

# Availability Zone (optional - override automatic AZ selection for single-node deployments)
# AWS_AZ="us-east-1a"

# Protocol Configuration
BLOCKCHAIN_PROTOCOL="avalanche"
DEPLOYMENT_MODE="single-node"
BC_NETWORK="fuji"
CLIENT_CONFIG="avalanchego-v1.15.1-full.yml"

# Instance Configuration
# i7i.xlarge: 4 vCPU, 32 GB RAM, 1 x 937 GB local NVMe - the instance type Ava
# Labs' own avalanche-deploy tooling uses for Primary Network nodes. Fuji carries
# far less traffic than mainnet; step up to i7i.2xlarge if the node falls behind.
INSTANCE_TYPE="i7i.xlarge"
CPU_TYPE="x86_64"

# Storage Configuration - NVMe instance store (wiped on stop/start)
DATA_VOLUMES_COUNT="1"
DATA_VOL_1_TYPE="instance-store"
DATA_VOL_1_SIZE="937"
DATA_VOL_1_MOUNT_PATH="/data"
DATA_VOL_1_FILESYSTEM="ext4"

# Snapshot Configuration
# No database snapshot: C-Chain state sync + P/X-Chain bootstrap from peers.
SNAPSHOT_ENABLED="false"
