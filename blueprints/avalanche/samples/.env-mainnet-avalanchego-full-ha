##############################################################
# Avalanche Mainnet - AvalancheGo (Full Node, non-validator, HA)
# x86_64, Auto Scaling Group behind an internal ALB
##############################################################

# AWS Configuration
AWS_ACCOUNT_ID="xxxxxxxxxxx"
AWS_REGION="us-east-1"

# Protocol Configuration
BLOCKCHAIN_PROTOCOL="avalanche"
DEPLOYMENT_MODE="ha-nodes"
BC_NETWORK="mainnet"
CLIENT_CONFIG="avalanchego-v1.15.1-full.yml"

# Instance Configuration
# i7i.2xlarge: 8 vCPU, 64 GB RAM, 1 x 1875 GB local NVMe (see the single-node sample).
INSTANCE_TYPE="i7i.2xlarge"
CPU_TYPE="x86_64"

# Storage Configuration - NVMe instance store
# A replaced instance starts empty and state-syncs again; each node gets its own NodeID.
DATA_VOLUMES_COUNT="1"
DATA_VOL_1_TYPE="instance-store"
DATA_VOL_1_SIZE="1875"
DATA_VOL_1_MOUNT_PATH="/data"
DATA_VOL_1_FILESYSTEM="ext4"

# Snapshot Configuration
SNAPSHOT_ENABLED="false"

# HA Configuration
HA_NUMBER_OF_NODES="2"
# GET /ext/health on the HTTP port returns 200 when every health check passes
# (including bootstrapping of the P, X and C chains) and 503 otherwise, so only
# fully bootstrapped nodes receive traffic.
HA_ALB_HEALTHCHECK_PORT="9650"
HA_ALB_HEALTHCHECK_PATH="/ext/health"
HA_ALB_HEALTHCHECK_HTTP_CODES="200"
# The ASG replaces a node that is still unhealthy when the grace period ends,
# and a replacement starts the sync from zero. Mainnet bootstrap via state sync
# takes 2-4 hours per the Avalanche docs; 360 minutes leaves headroom.
HA_ALB_HEALTHCHECK_GRACE_PERIOD_MIN="360"
HA_ALB_HEALTHCHECK_INTERVAL_SEC="30"
HA_ALB_HEALTHCHECK_TIMEOUT_SEC="10"
HA_ALB_HEALTHCHECK_HEALTHY_THRESHOLD="2"
HA_ALB_HEALTHCHECK_UNHEALTHY_THRESHOLD="3"
# The lifecycle hook completes before node.sh runs; node.sh itself finishes in
# minutes (Docker install + image pull), so the default-sized window is ample.
HA_NODES_HEARTBEAT_DELAY_MIN="60"
HA_ALB_DEREGISTRATION_DELAY_SEC="60"

# ALB Exposure (security)
# By default the load balancer is INTERNAL (reachable only inside the VPC) and
# ingress is restricted to the VPC CIDR. To expose the RPC endpoint beyond the
# VPC, uncomment and set the following:
# HA_ALB_INTERNET_FACING="true"          # expose the ALB to the internet (use with caution)
# HA_ALB_ALLOWED_CIDR="203.0.113.0/24"   # REQUIRED when internet-facing: restrict to trusted source IPs
# HA_ALB_CERTIFICATE_ARN="arn:aws:acm:REGION:ACCOUNT:certificate/ID"  # enable HTTPS (TLS terminated at the ALB)
